{
  "name": "spotify-mini-player",
  "version": "1.0.0",
  "description": "A Spotify mini-player overlay",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "clean": "rimraf dist",
    "generate-icons": "electron-icon-builder --input=./app-icon.png --output=./build",
    "build": "rimraf dist && electron-builder",
    "build-win": "rimraf dist && electron-builder --win",
    "build-mac": "rimraf dist && electron-builder --mac",
    "build-linux": "rimraf dist && electron-builder --linux"
  },
  "author": "Darian",
  "license": "ISC",
  "devDependencies": {
    "electron": "^32.1.0",
    "electron-builder": "^25.0.5",
    "electron-packager": "^17.1.2"
  },
  "dependencies": {
    "dotenv": "^16.4.1",
    "spotify-web-api-node": "^5.0.2"
  },
  "build": {
    "appId": "com.Darian.spotifyminiplayerapp",
    "productName": "Spotify Mini Player",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!**/.git",
      "!**/.vscode",
      "!build{,/**/*}",
      "!dist{,/**/*}"
    ],
    "extraFiles": [
      {
        "from": "node_modules/electron/dist/ffmpeg.dll",
        "to": "ffmpeg.dll"
      }
    ],
    "extraResources": [
      "./config.js",
      "./authServer.js",
      "./index.html",
      "./node_modules/spotify-web-api-node/**/*",
      "./node_modules/dotenv/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.dll",
      "**/*.node"
    ],
    "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "portable"
      }
    ],
    "sign": null
  },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.music"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "protocols": {
      "name": "spotify-mini-player-protocol",
      "schemes": [
        "spotify-mini-player"
      ]
    }
  }
}