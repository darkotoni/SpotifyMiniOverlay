{
  "name": "spotify-mini-player",
  "version": "1.0.0",
  "description": "A Spotify mini-player overlay",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build-win": "electron-builder --win",
    "build-mac": "electron-builder --mac",
    "build-linux": "electron-builder --linux"
  },
  "author": "Darian",
  "license": "ISC",
  "devDependencies": {
    "electron": "^32.1.0",
    "electron-builder": "^25.0.5",
    "electron-packager": "^17.1.2"
  },
  "dependencies": {
    "dotenv": "^16.4.1",
    "spotify-web-api-node": "^5.0.2"
  },
  "build": {
    "appId": "com.Darian.spotifyminiplayerapp",
    "productName": "Spotify Mini Player",
    "files": [
      "**/*",
      "!**/.git",
      "!**/.vscode",
      "!build{,/**/*}",
      "!dist{,/**/*}",
      "!node_modules{,/**/*}"
    ],
    "extraResources": [
      {
        "from": "node_modules",
        "to": "node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable"
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.music"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "protocols": {
      "name": "spotify-mini-player-protocol",
      "schemes": [
        "spotify-mini-player"
      ]
    }
  }
}